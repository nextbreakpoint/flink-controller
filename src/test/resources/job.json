{
  "jobParallelism": 2,
  "bootstrap": {
    "serviceAccount": "bootstrap-test",
    "pullSecrets": "bootstrap-regcred",
    "pullPolicy": "IfNotPresent",
    "image": "registry:30000/jobs:latest",
    "jarPath": "/flink-jobs.jar",
    "className": "com.nextbreakpoint.flink.controller.jobs.stream.TestJob",
    "arguments": [
      "--BUCKET_BASE_PATH",
      "file:///var/tmp"
    ]
  },
  "savepoint": {
    "savepointMode": "Automatic",
    "savepointInterval": "60",
    "savepointTargetPath": "file:///var/tmp/test"
  },
  "restart": {
    "restartPolicy": "Never",
    "restartDelay": 60,
    "restartTimeout": 120
  }
}