	<scm>
		<connection>scm:git:git@github.com:nextbreakpoint/flinkctl.git</connection>
		<developerConnection>scm:git:git@github.com:nextbreakpoint/flinkctl.git</developerConnection>
		<url>git@github.com:nextbreakpoint/flinkctl.git</url>
