	<properties>
		<java.version>11</java.version>
		<java.release>11</java.release>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<kotlin.compiler.languageVersion>2.0</kotlin.compiler.languageVersion>
		<kotlin.compiler.apiVersion>2.0</kotlin.compiler.apiVersion>
		<kotlin.code.style>official</kotlin.code.style>
		<maven.version>3.9</maven.version>
		<kotlin.version>2.0.21</kotlin.version>
		<lombok.version>1.18.36</lombok.version>
		<gson.version>2.11.0</gson.version>
		<slf4j.version>2.0.16</slf4j.version>
		<vertx.version>4.5.11</vertx.version>
		<clikt.version>2.8.0</clikt.version>
		<jaxb.version>2.4.0-b180830.0359</jaxb.version>
		<activation.version>1.1.1</activation.version>
		<micrometer.version>1.14.1</micrometer.version>
		<jackson.version>2.18.1</jackson.version>
