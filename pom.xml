	<groupId>com.nextbreakpoint</groupId>
	<artifactId>com.nextbreakpoint.flinkctl</artifactId>
	<version>1.5.0</version>
	<packaging>jar</packaging>
	<name>NextBreakpoint Flink Control</name>
	<description>Flink Control</description>
	<url>https://github.com/nextbreakpoint/flinkctl</url>
	<licenses>
		<license>
			<name>BSD 3</name>
			<url>http://nextbreakpoint.com/licenses/BSD3</url>
